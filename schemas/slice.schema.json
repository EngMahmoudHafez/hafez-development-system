{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hafez.dev/schemas/slice.schema.json",
  "title": "HDS vertical slice",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "objective",
    "status",
    "businessRules",
    "acceptanceCriteria",
    "workUnits",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hds-slice/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^S-[0-9]{2,4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "in-progress",
        "blocked",
        "ready",
        "released"
      ]
    },
    "businessRules": {
      "type": "array"
    },
    "acceptanceCriteria": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "decisions": {
      "type": "array"
    },
    "workUnits": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "id",
              "objective",
              "dependencies",
              "risk",
              "workerTier",
              "access",
              "parallelSafe",
              "allowedPaths",
              "verification",
              "acceptanceCriteria",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^WU-[0-9]{2,4}$"
              },
              "objective": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "risk": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "workerTier": {
                "enum": [
                  "scout",
                  "worker",
                  "specialist",
                  "lead"
                ]
              },
              "access": {
                "enum": [
                  "read-only",
                  "write-worktree"
                ]
              },
              "parallelSafe": {
                "type": "boolean"
              },
              "allowedPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "verification": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "acceptanceCriteria": {
                "type": "array"
              },
              "integrationNotes": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "planned",
                  "ready",
                  "active",
                  "blocked",
                  "completed"
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "verification": {
      "type": "array"
    },
    "openQuestions": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
