{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hafez.dev/schemas/workspace.schema.json",
  "title": "HDS multi-repository workspace",
  "type": "object",
  "required": ["schemaVersion", "repositories", "contracts"],
  "properties": {
    "schemaVersion": { "const": "hds-workspace/v1" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "producer", "consumers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "producer": { "$ref": "#/$defs/contractEndpoint" },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/contractEndpoint" }
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "contractEndpoint": {
      "type": "object",
      "required": ["repository", "path"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
