{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hafez.dev/schemas/lead-decomposition-response.schema.json",
  "title": "HDS standalone lead decomposition response",
  "type": "object",
  "required": [
    "schemaVersion",
    "summary",
    "workUnits",
    "ownerDecision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hds-lead-decomposition-response/v1"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "workUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "objective",
          "role",
          "dependencies",
          "risk",
          "workerTier",
          "access",
          "parallelSafe",
          "allowedPaths",
          "verification",
          "acceptanceCriteria",
          "integrationNotes",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WU-[0-9]{2,4}$"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "workerTier": {
            "enum": [
              "scout",
              "worker",
              "specialist",
              "lead"
            ]
          },
          "access": {
            "enum": [
              "read-only",
              "write-worktree"
            ]
          },
          "parallelSafe": {
            "type": "boolean"
          },
          "allowedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "acceptanceCriteria": {
            "type": "array"
          },
          "integrationNotes": {
            "type": "string"
          },
          "status": {
            "const": "planned"
          }
        },
        "additionalProperties": false
      }
    },
    "ownerDecision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "question",
            "category",
            "reason"
          ],
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "enum": [
                "product",
                "business",
                "architecture",
                "legal",
                "compliance",
                "privacy"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
